# Corretor Social
# Nunca commitar valores reais.

# Aplicação
NEXT_PUBLIC_APP_URL=https://greenyellow-duck-334187.hostingersite.com

# Supabase — usado pelo app, autenticação, Storage, fila e integrações
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI — somente server-side
OPENAI_API_KEY=

# Meta — OAuth para Facebook Pages + Instagram profissional
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
META_GRAPH_VERSION=v26.0
# Opcional: mantenha o ID disponível, mas o fluxo simples não o usa por padrão.
META_LOGIN_CONFIG_ID=
# Ative somente se quisermos voltar ao seletor de ativos do Login for Business.
META_USE_LOGIN_CONFIG=false

# 32 bytes aleatórios em Base64. Nunca trocar sem recriptografar os tokens salvos.
SOCIAL_TOKEN_ENCRYPTION_KEY=

# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# Google Business Profile
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Enable only after the background worker is deployed.
MEDIA_ANALYSIS_ENABLED=false
